{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-takshu"
		},
		"AzureSql_ls_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSql_ls'"
		},
		"FileServer_ls_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'FileServer_ls'"
		},
		"datalake_ls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'datalake_ls'"
		},
		"AzureSql_ls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adfprojectservertakshu.database.windows.net"
		},
		"AzureSql_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "SQLdbtakshu"
		},
		"AzureSql_ls_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Shweta"
		},
		"FileServer_ls_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\ADF_Project"
		},
		"FileServer_ls_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "Shweta"
		},
		"datalake_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://firstprojstorageacc.dfs.core.windows.net/"
		},
		"ls_github_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-takshu_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSql_ls_password": {
						"value": "[parameters('AzureSql_ls_password')]"
					},
					"datalake_ls_accountKey": {
						"value": "[parameters('datalake_ls_accountKey')]"
					},
					"FileServer_ls_password": {
						"value": "[parameters('FileServer_ls_password')]"
					},
					"AzureSql_ls_properties_typeProperties_server": {
						"value": "[parameters('AzureSql_ls_properties_typeProperties_server')]"
					},
					"AzureSql_ls_properties_typeProperties_database": {
						"value": "[parameters('AzureSql_ls_properties_typeProperties_database')]"
					},
					"AzureSql_ls_properties_typeProperties_userName": {
						"value": "[parameters('AzureSql_ls_properties_typeProperties_userName')]"
					},
					"datalake_ls_properties_typeProperties_url": {
						"value": "[parameters('datalake_ls_properties_typeProperties_url')]"
					},
					"ls_github_properties_typeProperties_url": {
						"value": "[parameters('ls_github_properties_typeProperties_url')]"
					},
					"FileServer_ls_properties_typeProperties_host": {
						"value": "[parameters('FileServer_ls_properties_typeProperties_host')]"
					},
					"FileServer_ls_properties_typeProperties_userId": {
						"value": "[parameters('FileServer_ls_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-takshu_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-takshu_ArmTemplate_0')]"
			]
		}
	]
}